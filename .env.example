# Local development defaults.
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=false
CORS_ORIGINS=*
MAX_CONTENT_LENGTH=33554432

# Required model artifact. If MODEL_PATH is absent in deployment, configure MODEL_DOWNLOAD_URL.
MODEL_PATH=models/efficientnet_best_model.keras
MODEL_DOWNLOAD_URL=
# Optional integrity check for the downloaded model artifact.
MODEL_SHA256=

# Local Ollama default. Set OLLAMA_URL to an externally reachable Ollama-compatible endpoint in deployment.
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.1
# Optional bearer token for an external LLM endpoint. Never commit a real value.
OLLAMA_API_KEY=
# Retry only temporary failures; maximum is capped at 3 retries and 5 seconds delay.
OLLAMA_MAX_RETRIES=1
OLLAMA_RETRY_DELAY_SECONDS=0.5
# Optional provider price; leave blank when no verified per-token price is available.
OLLAMA_COST_PER_1000_TOKENS=
